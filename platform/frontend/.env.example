# Frontend uses same-origin /v1 by default, then proxies to backend.
VITE_API_BASE_URL="/v1"
VITE_API_PROXY_TARGET="http://127.0.0.1:8080"

# AI report generation. Use "deepseek" for the official API, or "local" for a
# local OpenAI-compatible DeepSeek runtime such as Ollama, vLLM, or LM Studio.
AI_PROVIDER=deepseek
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=MY_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat

# Reserved local DeepSeek adapter config. Enable with AI_PROVIDER=local.
LOCAL_DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_DEEPSEEK_MODEL=deepseek-r1:7b
LOCAL_DEEPSEEK_API_KEY=local

AI_API_TIMEOUT_MS=60000
AI_TEMPERATURE=0.2
