# 本文件是后端配置示例；config.Load 会读取当前目录下所有 .env* 文件并合并为 config.C。
APP_NAME=WFAgent
APP_ENV=dev
APP_VERSION=0.1.0

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

DB_ENABLED=true
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-change-me
POSTGRES_DATABASE=wfagent_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=100
POSTGRES_CONN_MAX_LIFETIME=1h

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

JWT_ACCESS_SECRET=please-run-make-init-secret-or-openssl-rand-hex-32
JWT_REFRESH_SECRET=please-run-make-init-secret-or-openssl-rand-hex-32
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h
JWT_ISSUER=wfagent

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_ALLOW_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WINDOW=1m

AUDIT_LOG_FILE=logs/audit.log
AUDIT_LOG_MAX_SIZE_MB=20
AUDIT_LOG_MAX_BACKUPS=5
AUDIT_PERSIST_TO_DB=false

FILE_STORAGE_DRIVER=minio
FILE_UPLOAD_DIR=storage/uploads
FILE_MAX_UPLOAD_MB=50
FILE_ALLOWED_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.png,.jpg,.jpeg,.txt,.csv,.zip
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=wfagent
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

TASK_WORKER_COUNT=2
TASK_RETRY_LIMIT=3
LOG_LEVEL=info

AI_SERVICE_BASE_URL=http://127.0.0.1:9100
AI_SERVICE_TIMEOUT=60s

# Microsoft Graph OAuth（仅本地 .env 填真实值，勿提交）
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/v1/integrations/microsoft/callback
MICROSOFT_GRAPH_SCOPES=openid,profile,offline_access,User.Read,Mail.ReadWrite,Mail.Send
MICROSOFT_TOKEN_ENCRYPTION_KEY=
APP_FRONTEND_URL=http://localhost:3000
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8201
KNOWLEDGE_SERVICE_API_KEY=replace-with-the-knowledge-internal-key
KNOWLEDGE_SERVICE_TIMEOUT=30s
