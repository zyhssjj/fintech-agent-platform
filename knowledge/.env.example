# Elasticsearch（宿主机本地端口）
ES_URL=http://localhost:9202
KNOWLEDGE_INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# 模型配置主密钥（Fernet 加密 API Key 用；生产环境通过服务器环境变量设置）
LLM_CONFIG_MASTER_KEY=
RERANK_CONFIG_MASTER_KEY=

# 可选一次性导入：模型注册表为空时，用这些值创建云端模型条目
# LLM（查询路由 / C1 关联增强 / C2 语义切块 / 可选答案生成）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-max
LLM_THINKING=disabled
SEMANTIC_INGEST_MAX_TOKENS=4000

# Embedding（云端，1024 维，与索引 dims 一致）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# 重排（云端，DashScope 原生 qwen3 rerank 或兼容 /reranks 服务，在"模型配置"页维护）
RERANK_PROVIDER=aliyun-qwen3

# 本地 OCR 模型（离线识别扫描件，不调云端）
OCR_MODELS_DIR=models/rapidocr
PDF_MAX_PAGES=500
PDF_OCR_MAX_PAGES=200
PDF_OCR_DPI=144
PDF_OCR_MAX_PIXELS=16000000
PDF_OCR_TILE_HEIGHT=4000
PDF_OCR_TILE_OVERLAP=160
PDF_MIN_PAGE_TEXT=30

# 审计与任务保留
LLM_AUDIT_RETENTION_DAYS=180
LLM_AUDIT_MAX_RECORDS=100000
LLM_AUDIT_MAX_BYTES=52428800
RERANK_AUDIT_RETENTION_DAYS=180
RERANK_AUDIT_MAX_RECORDS=100000
RERANK_AUDIT_MAX_BYTES=52428800
AUTH_AUDIT_RETENTION_DAYS=365
AUTH_AUDIT_MAX_RECORDS=100000
JOB_RETENTION_DAYS=90
JOB_MAX_RECORDS=2000
STALE_STAGING_RETENTION_HOURS=24
